{
  "$schema": "https://design-tokens.org/schema.json",
  "description": "Alias (semantic) tokens — referenciam global tokens e definem funcao contextual.",
  "color": {
    "surface": {
      "default":  { "value": "{color.gray.50}",  "type": "color", "description": "Fundo principal da pagina" },
      "subtle":   { "value": "{color.gray.100}", "type": "color", "description": "Fundo secundario" },
      "elevated": { "value": "#FFFFFF",           "type": "color", "description": "Cards e elementos elevados" },
      "overlay":  { "value": "rgba(0,0,0,0.5)",  "type": "color", "description": "Scrim de modais" }
    },
    "text": {
      "default":  { "value": "{color.gray.900}", "type": "color", "description": "Texto principal" },
      "subtle":   { "value": "{color.gray.600}", "type": "color", "description": "Texto secundario" },
      "muted":    { "value": "{color.gray.400}", "type": "color", "description": "Texto desabilitado" },
      "on-action":{ "value": "#FFFFFF",           "type": "color", "description": "Texto sobre botao primario" },
      "link":     { "value": "{color.blue.600}",  "type": "color", "description": "Links" }
    },
    "action": {
      "primary":        { "value": "{color.blue.600}",  "type": "color" },
      "primary-hover":  { "value": "{color.blue.700}",  "type": "color" },
      "secondary":      { "value": "{color.gray.100}",  "type": "color" },
      "secondary-hover":{ "value": "{color.gray.200}",  "type": "color" },
      "danger":         { "value": "{color.red.600}",   "type": "color" },
      "danger-hover":   { "value": "{color.red.700}",   "type": "color" },
      "disabled":       { "value": "{color.gray.200}",  "type": "color" }
    },
    "feedback": {
      "success-bg":  { "value": "{color.green.50}",   "type": "color" },
      "success-text":{ "value": "{color.green.700}",  "type": "color" },
      "warning-bg":  { "value": "{color.yellow.50}",  "type": "color" },
      "warning-text":{ "value": "{color.yellow.800}", "type": "color" },
      "error-bg":    { "value": "{color.red.50}",     "type": "color" },
      "error-text":  { "value": "{color.red.700}",    "type": "color" },
      "info-bg":     { "value": "{color.blue.50}",    "type": "color" },
      "info-text":   { "value": "{color.blue.700}",   "type": "color" }
    },
    "border": {
      "default": { "value": "{color.gray.200}", "type": "color" },
      "subtle":  { "value": "{color.gray.100}", "type": "color" },
      "strong":  { "value": "{color.gray.400}", "type": "color" },
      "focus":   { "value": "{color.blue.500}", "type": "color" }
    }
  },
  "typography": {
    "heading-lg": {
      "fontFamily": { "value": "Inter, sans-serif" },
      "fontSize":   { "value": "{fontSize.3xl}" },
      "fontWeight": { "value": "{fontWeight.bold}" },
      "lineHeight": { "value": "1.2" }
    },
    "heading-md": {
      "fontFamily": { "value": "Inter, sans-serif" },
      "fontSize":   { "value": "{fontSize.2xl}" },
      "fontWeight": { "value": "{fontWeight.semibold}" },
      "lineHeight": { "value": "1.25" }
    },
    "body-md": {
      "fontFamily": { "value": "Inter, sans-serif" },
      "fontSize":   { "value": "{fontSize.md}" },
      "fontWeight": { "value": "{fontWeight.regular}" },
      "lineHeight": { "value": "1.5" }
    },
    "body-sm": {
      "fontFamily": { "value": "Inter, sans-serif" },
      "fontSize":   { "value": "{fontSize.sm}" },
      "fontWeight": { "value": "{fontWeight.regular}" },
      "lineHeight": { "value": "1.5" }
    }
  },
  "elevation": {
    "sm": { "value": "0 1px 2px rgba(0,0,0,0.06), 0 2px 4px rgba(0,0,0,0.08)", "type": "boxShadow" },
    "md": { "value": "0 2px 4px rgba(0,0,0,0.04), 0 4px 8px rgba(0,0,0,0.12)", "type": "boxShadow" },
    "lg": { "value": "0 4px 8px rgba(0,0,0,0.04), 0 8px 16px rgba(0,0,0,0.16)", "type": "boxShadow" }
  }
}
